<?xml version="1.0" encoding="UTF-8"?>
<addon id="script.module.tmdbhelper.sync.floppy" version="1.0.0" name="TMDbHelper Sync - Floppy" provider-name="haywirephoenix">
    <requires>
        <import addon="xbmc.python" version="3.0.1"/>
        <import addon="script.module.jurialmunkey" version="0.2.35"/>
        <import addon="plugin.video.themoviedb.helper" version="6.19.0"/>
    </requires>
    <extension point="xbmc.python.module" library="resources/lib"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Floppy sync provider for TMDbHelper</summary>
        <description lang="en_GB">Watched history, resume points, watchlist, dropped shows, next episodes, synced-state actions and scrobbling for TMDbHelper from a self-hosted Floppy tracker. Uses the address and API token from the Floppy add-on (plugin.video.floppy) unless set here.</description>
        <disclaimer lang="en_GB">Requires a running Floppy instance and its API token (Floppy, Settings, Integrations, API Token).</disclaimer>
        <platform>all</platform>
        <license>GPL-3.0-or-later</license>
        <source>https://github.com/haywirephoenix/script.module.tmdbhelper.sync.floppy</source>
        <assets>
            <icon>resources/icon.png</icon>
            <fanart>resources/fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
